[Unit]
Description=Tiaoliao web application
After=network.target

[Service]
Type=simple
User=tiaoliao
Group=tiaoliao
WorkingDirectory=/opt/tiaoliao/current/server
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DB_PATH=/var/lib/tiaoliao/tiaoliao.db
Environment=UPLOAD_DIR=/var/lib/tiaoliao/uploads
ExecStart=/opt/tiaoliao/node/bin/node --disable-warning=ExperimentalWarning src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tiaoliao
UMask=0027

[Install]
WantedBy=multi-user.target
