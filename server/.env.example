# 复制此文件为 .env 后按需修改
# PowerShell: Copy-Item .env.example .env

PORT=3000
# 服务器通过反向代理访问时设置为 127.0.0.1
HOST=0.0.0.0

# 图片保存在发布目录以外，生产环境指定持久目录
UPLOAD_DIR=data/uploads
NODE_ENV=development

# SQLite 数据库文件路径（相对于 server/ 目录）
DB_PATH=data/dev.db

# 会话有效期（天）
SESSION_DAYS=30

# ── 微信小程序（暂时留空，拿到 AppID 后再填）──
# 填写后 /api/auth/wechat-login 自动启用
WX_APPID=
WX_SECRET=

# ── AI 推荐（可选）──
# 留空则走「规则模式」：用数据库真实数据拼回答，功能完整、零成本。
# 填了就自动切到模型模式，接口形状不变。
# 任何 OpenAI 兼容的服务都可以：DeepSeek / 通义 / 智谱 / 自建 vLLM
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_API_KEY=sk-xxxx
# AI_TIMEOUT=20000
# 聊天模型解析时限；超时保留规则识别（单位毫秒，最大 10000）
# AI_INTENT_TIMEOUT_MS=6500
